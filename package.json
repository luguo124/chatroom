{
  "name": "monadchat",
  "private": true,
  "version": "0.1.0",
  "description": "MonadChat — 基于 Monad 区块链的去中心化端到端加密私密聊天室",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
